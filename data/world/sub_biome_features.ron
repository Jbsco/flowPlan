                slope_tolerance_max_deg: 12.0,
                roughness_tolerance_m: 80.0,
                water_adjacency: None,
                altitude_range_m: (1200.0, 2400.0),
                selection_weight: 0.2,
                is_bleed_over_candidate: true,
            ),
            (
