    // ═══════════════════════════════════════════════════════════════════════
    // Biome-receiving adaptations (PINNED 2026-04-23 — primary mechanism)
    // ═══════════════════════════════════════════════════════════════════════
    //
    // When a foreign feature bleeds into a host biome (via the 3.6.2
    // bleed-over mechanism), the host biome IMPRESSES ITS CHARACTER on
    // the imported palette. Each biome declares an HSV shift per
    // palette-category (building_wooden, vegetation, stone, etc.).
    //
    // Resolution order (see `adapt_palette` in sub_biome.rs):
    //   1. Feature's `adaptation_per_host[host]` — explicit override
    //   2. This table: `biome_receiving_adaptations[host][feature.category]`
    //   3. This table: `biome_receiving_adaptations[host]["default"]`
    //   4. Feature's unmodified `home_palette` (no adaptation)
    //
    // HSV shifts capture warm/cool/saturate/desaturate/lighten/darken
    // cleanly. Compositing operations (snow dusting on roofs, moss on
    // stonework, algae on docks) are a RENDER-LAYER concern — left
    // intentionally blank here; planned for 3.6.4+ flora/decoration
    // pass as a separate overlay system.
    //
    // Authoring guidance per biome:
    //   • HighDesert    — warm+ hue, dry (desaturate vegetation),
    //                     sun-bleached (value+), sandstone tones.
    //   • RockyAlpine   — cool- hue, weathered (saturation-),
    //                     shadow-darker (value-), granite grey.
    //   • CoastalBoreal — slight green-shift, moist (saturation-),
    //                     overcast (value-), moss-greyed stones.
    //   • Mediterranean — warm+ hue, sun-saturated, whitewash
    //                     (masonry → white), turquoise water pop.

    biome_receiving_adaptations: {
        "HighDesert": {
            "building_wooden":  (hue_shift_deg: 8.0,   saturation_mult: 1.10, value_mult: 1.15),
            "building_masonry": (hue_shift_deg: 5.0,   saturation_mult: 1.05, value_mult: 1.00),
            "vegetation":       (hue_shift_deg: 15.0,  saturation_mult: 0.60, value_mult: 1.10),
            "stone":            (hue_shift_deg: 10.0,  saturation_mult: 1.00, value_mult: 1.10),
            "water":            (hue_shift_deg: -5.0,  saturation_mult: 0.95, value_mult: 1.00),
            "signage":          (hue_shift_deg: 5.0,   saturation_mult: 1.00, value_mult: 1.05),
            "textile":          (hue_shift_deg: 8.0,   saturation_mult: 0.90, value_mult: 1.05),
            "default":          (hue_shift_deg: 5.0,   saturation_mult: 1.00, value_mult: 1.05),
        },
        "RockyAlpine": {
            "building_wooden":  (hue_shift_deg: -5.0,  saturation_mult: 0.80, value_mult: 0.90),
            "building_masonry": (hue_shift_deg: -3.0,  saturation_mult: 0.90, value_mult: 0.95),
            "vegetation":       (hue_shift_deg: -3.0,  saturation_mult: 0.95, value_mult: 1.00),
            "stone":            (hue_shift_deg: -5.0,  saturation_mult: 0.85, value_mult: 0.95),
            "water":            (hue_shift_deg: -8.0,  saturation_mult: 1.05, value_mult: 1.05),
            "signage":          (hue_shift_deg: -2.0,  saturation_mult: 0.95, value_mult: 0.95),
            "textile":          (hue_shift_deg: -3.0,  saturation_mult: 0.85, value_mult: 0.90),
            "default":          (hue_shift_deg: -3.0,  saturation_mult: 0.90, value_mult: 0.95),
        },
        "CoastalBoreal": {
            "building_wooden":  (hue_shift_deg: 3.0,   saturation_mult: 0.85, value_mult: 0.90),
            "building_masonry": (hue_shift_deg: 5.0,   saturation_mult: 0.90, value_mult: 0.95),
            "vegetation":       (hue_shift_deg: 8.0,   saturation_mult: 1.00, value_mult: 0.95),
            "stone":            (hue_shift_deg: 10.0,  saturation_mult: 0.85, value_mult: 0.90),
            "water":            (hue_shift_deg: 5.0,   saturation_mult: 0.90, value_mult: 0.90),
            "signage":          (hue_shift_deg: 5.0,   saturation_mult: 0.90, value_mult: 0.95),
            "textile":          (hue_shift_deg: 3.0,   saturation_mult: 0.85, value_mult: 0.90),
            "default":          (hue_shift_deg: 5.0,   saturation_mult: 0.90, value_mult: 0.95),
        },
        "MediterraneanArchipelago": {
            "building_wooden":  (hue_shift_deg: 5.0,   saturation_mult: 0.95, value_mult: 1.10),
            "building_masonry": (hue_shift_deg: 15.0,  saturation_mult: 0.70, value_mult: 1.20),
            "vegetation":       (hue_shift_deg: 10.0,  saturation_mult: 0.85, value_mult: 1.05),
            "stone":            (hue_shift_deg: 12.0,  saturation_mult: 0.85, value_mult: 1.15),
            "water":            (hue_shift_deg: -5.0,  saturation_mult: 1.20, value_mult: 1.10),
            "signage":          (hue_shift_deg: 8.0,   saturation_mult: 1.10, value_mult: 1.10),
            "textile":          (hue_shift_deg: 10.0,  saturation_mult: 1.15, value_mult: 1.10),
            "default":          (hue_shift_deg: 10.0,  saturation_mult: 1.00, value_mult: 1.10),
        },
    },
)
