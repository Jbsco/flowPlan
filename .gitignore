# Rust build artifacts
/target/
**/*.rs.bk
*.pdb

# Cargo registry / state
# NOTE: .cargo/config.toml IS committed (determinism discipline build flags
# per CODING_RULES.md § Determinism Discipline must apply to every checkout).
# Ignore specific cache / credential files inside .cargo/, not the whole dir.
/.cargo/credentials
/.cargo/credentials.toml
/.cargo/registry/
/.cargo/git/
# Cargo.lock is committed for the binary / app; do not ignore.

# Profiling captures
*.tracy
tracy-*.json
perf.data*
*.flamegraph

# Asset build cache (populated by tools/)
/asset-cache/
/build-cache/

# IDE / editor noise
.vscode/
.idea/
*.iml
*.swp
*.swo
*.orig
*.rej

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Coverage
/coverage/
tarpaulin-report.*

# Personal scratch (not committed)
/scratch/
/.scratch/
